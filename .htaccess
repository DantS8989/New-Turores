RewriteEngine On

# Bloquear archivos y carpetas ocultos, excepto .well-known
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# Bloquear el acceso web a las carpetas internas
RewriteRule ^(aplicacion|configuracion|base_datos)(/|$) - [F,L]

# Permitir solamente subidas dentro de almacenamiento
RewriteRule ^almacenamiento(?:/(?!subidas(?:/|$))|$) - [F,L]

# Bloquear archivos de documentación
RewriteRule ^README\.md$ - [F,L,NC]

# Abrir la página principal
RewriteRule ^$ publico/index.html [L]

# Abrir las páginas del frontend desde la raíz
RewriteRule ^(index|login|mensajes|perfil|registro|tutor)\.html$ publico/$1.html [L]

# Cargar CSS, JavaScript e imágenes desde publico/recursos
RewriteRule ^recursos/(.*)$ publico/recursos/$1 [L]